APP_ENV=development
HTTP_PORT=8080
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# docker-compose.yml uses POSTGRES_PASSWORD to compose DATABASE_URL.
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgres://app:change_this_local_password@localhost:5432/career_consultations?sslmode=disable

# Values from the VK Mini App settings. Keep the secret only on the server.
VK_APP_ID=
VK_APP_SECRET=
# Comma-separated VK IDs allowed to use the consultant/admin role.
ADMIN_VK_IDS=

# Use a random secret with at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-secret-before-production
JWT_ACCESS_TTL=1h

FILE_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# Empty AI_PROVIDER disables resume analysis without affecting consultations.
# For an OpenAI-compatible endpoint, use openai-compatible and set AI_BASE_URL.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT=30s

# Comma-separated exact origins. In development localhost origins are allowed.
CORS_ALLOWED_ORIGINS=
REMINDER_ENABLED=false
NOTIFICATION_PROVIDER=vk
NOTIFICATION_API_TOKEN=
VK_API_VERSION=5.199
