# Local development defaults. Replace secrets before deployment.
APP_ENV=development
HTTP_PORT=8080
# Use URL-safe characters: this password is also included in DATABASE_URL.
POSTGRES_PASSWORD=local-development-only
JWT_SECRET=
JWT_ACCESS_TTL=1h
VK_APP_ID=
VK_APP_SECRET=
ADMIN_VK_IDS=
MAX_UPLOAD_SIZE_MB=10
# Required in production: exact public frontend origin (https://...).
CORS_ALLOWED_ORIGINS=
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT=30s
REMINDER_ENABLED=false
NOTIFICATION_PROVIDER=vk
NOTIFICATION_API_TOKEN=
VK_API_VERSION=5.199